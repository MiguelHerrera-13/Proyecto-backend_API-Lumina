    {
      "name": "5. Alertas Clínicas (Issue #16 / B-10)",
      "item": [
        {
          "name": "5.1 Consultar Alertas No Leídas (Por Defecto)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/alertas/medico/1"
          }
        },
        {
          "name": "5.2 Consultar Alertas Leídas (Filtro leida=true)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/alertas/medico/1?leida=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "alertas", "medico", "1"],
              "query": [{"key": "leida", "value": "true"}]
            }
          }
        },
        {
          "name": "5.3 Marcar Alerta como Leída (PATCH)",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:8080/api/alertas/medico/1/1/leida"
          }
        },
        {
          "name": "5.4 Prueba de Idempotencia (Reenviar PATCH)",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:8080/api/alertas/medico/1/1/leida"
          }
        },
        {
          "name": "5.5 Prueba de Seguridad (IDOR - 404 Not Found)",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:8080/api/alertas/medico/999/1/leida"
          }
        }
      ]
    },
