            "body": {
              "mode": "raw",
              "raw": "{\n  \"idTurno\": 1,\n  \"temperatura\": 39.5,\n  \"presionArterial\": \"190/120\",\n  \"observacion\": \"Fiebre muy alta y presión arterial descompensada.\"\n}"
